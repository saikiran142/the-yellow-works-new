# Copy to .env.local. Never commit real values.
# Public site URL used for metadata, sitemap and Open Graph. Not live yet.
NEXT_PUBLIC_SITE_URL=https://theyellowworks.com
# Shown on the site only when set. Leave empty until confirmed.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TARGET_CITY=

# --- Phase 3 ---
# Where enquiries are delivered: a webhook that accepts a JSON POST (form service, automation, small endpoint). Server-side only.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
# Leave unset until launch. "true" lets search engines index the site and publishes the sitemap.
NEXT_PUBLIC_ALLOW_INDEXING=
# Optional analytics, loaded only after the visitor accepts. Provider: plausible. Domain: the site domain registered with the provider.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
